# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# SQLite Database
DATABASE_URL=sqlite://c_note.db?mode=rwc

# Upload directory for call audio recordings
UPLOAD_DIR=./uploads

# Custom Speech-to-Text (STT) Streaming WebSocket
STT_WS_URL=ws://127.0.0.1:9001/ws/stt
STT_API_KEY=
STT_SAMPLE_RATE=16000

# Custom LLM Streaming WebSocket
LLM_WS_URL=ws://127.0.0.1:9002/ws/llm
LLM_API_KEY=
LLM_MODEL=custom-call-summarizer

# Mock fallback: if true, returns simulated results when external STT/LLM WS are not yet reachable
ENABLE_MOCK_FALLBACK=true

